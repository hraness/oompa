# Convex deployment variables for the hosted prose responder (`POST /v1/autorespond`).
# Set them on the deployment with `npx convex env set NAME value`; this file only
# documents the names. The route stays inert (HTTP 503) until all three are set.
#
# Origin of the Hraness credits service; the hosted backend places holds here.
OOMPA_CREDITS_SERVICE_ORIGIN=https://credits.hraness.com
# Product key the credits service issued for product id `oompa` (cr_prod_...).
OOMPA_CREDITS_PRODUCT_KEY=
# Operator's Vercel AI Gateway key used for hosted replies. People who bring their
# own key never touch this route.
AI_GATEWAY_API_KEY=
